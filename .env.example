# ===== 必填 =====
# BotFather 创建机器人得到的 Token
BOT_TOKEN=123456789:AAxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# 目标群 ID（超级群，如 -1001234567890）。把机器人拉进群后在群里发 /id 可查看
GROUP_CHAT_ID=-1001234567890

# ===== Mini App（弹窗发言）相关 =====
# Mini App 的公网 HTTPS 地址（指向本服务的域名，末尾带 /）
WEBAPP_URL=https://bot.example.com/
# 可选，一般留空即可：走 BotFather「Bot Settings → Mini App」启用的主小程序
# 不需要短名，弹窗按钮自动用 t.me/<机器人>?startapp= 链接。
# 只有改用 /newapp 建的命名小程序时，才把它的 short name 填在这里
APP_SHORT_NAME=

# ===== 可选 =====
# 群名（启动后会自动用群真实标题覆盖显示）
GROUP_NAME=A6api—Token交易所
# 机器人显示名（仅用于 WebApp 页脚等文案）
BOT_NAME=A6api助理
# 额外的管理员用户 ID（逗号分隔）。群管理员本身就有核查/删除/封禁权限
ADMIN_IDS=
# 代号派生盐（留空则由 Token 派生；更换会导致所有人的代号变化）
CODENAME_SALT=
# 监听端口
PORT=8080
